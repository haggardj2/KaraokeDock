# Root build context, including builds using dev/Dockerfile.
# Component-local builds use the .dockerignore in that component.
.git
# The root image only builds src/web and src/server.
Gateway
Station
docs
dev
**/node_modules
**/dist
**/build
**/out
**/.build
**/release
**/*.tsbuildinfo

# Generated web JavaScript must not shadow the TypeScript source in Vite.
src/web/src/**/*.js
src/web/src/**/*.js.map
src/web/src/**/*.d.ts.map

# Local configuration, data, and media
**/.env
**/.env.*
